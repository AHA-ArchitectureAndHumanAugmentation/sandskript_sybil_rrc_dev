#!/usr/bin/env python3
"""
300_watch_and_run.py

Watches a folder for new toolpath captures (from Lin's depth-cam pipeline,
a separate repo/conda environment on this same machine) and automatically
runs 301 -> 302 whenever a new one appears.

Filesystem-watching, not MQTT/ZeroMQ -- the right-sized choice for one
machine, no broker or topic schema needed. If the camera rig and robot
control ever end up on separate machines, this is the one file to swap
for a network listener -- 301/302 themselves wouldn't need to change.

Run this from the compas_rrc environment (same one main.py runs in).
It doesn't matter what environment Lin's pipeline runs in -- this only
reacts to files appearing on disk.

304 (actual robot execution) is deliberately NOT triggered here. This
only prepares and previews -- running the robot stays a manual step.

NOTE: 301 and 302 each open a blocking compas_viewer window. This script
does not run fully unattended -- each detected capture still needs that
window closed before the next one is processed.
"""

import subprocess
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent

# TODO: confirm with Lin -- point this at wherever her pipeline actually
# writes finished captures, if it's not this repo's own data/in.
WATCH_DIR = ROOT / "data" / "in"

POLL_INTERVAL = 2.0     # seconds between checks
SETTLE_TIME = 1.0       # seconds a file's size must stay unchanged before it's treated as "done writing"


def is_file_stable(path, settle_time=SETTLE_TIME):
    """True once `path`'s size hasn't changed for `settle_time` seconds --
    avoids triggering on a file that's still mid-write."""
    try:
        size_before = path.stat().st_size
    except FileNotFoundError:
        return False
    time.sleep(settle_time)
    try:
        size_after = path.stat().st_size
    except FileNotFoundError:
        return False
    return size_before == size_after


def run_pipeline(path_json):
    folder_name = path_json.parent.name
    compas_path = ROOT / "data" / "compas" / f"{folder_name}_compas.json"

    print(f"\n=== New capture detected: {path_json} ===")

    print("=== 301: convert ===")
    subprocess.run(["python", "301_convert_to_compas_json.py", str(path_json)], check=True)

    print("=== 302: process ===")
    subprocess.run(["python", "302_process_toolpath.py", str(compas_path)], check=True)

    print(f"=== Pipeline complete for {folder_name} -- ready for manual review in 304 ===\n")


def main():
    print(f"Watching for new captures in: {WATCH_DIR}")
    print("Only NEW captures from this point forward are processed -- existing files are ignored.")
    print("Press Ctrl+C to stop.\n")

    seen = set(WATCH_DIR.glob("*/path.json"))

    try:
        while True:
            time.sleep(POLL_INTERVAL)
            current = set(WATCH_DIR.glob("*/path.json"))

            for path_json in current - seen:
                if not is_file_stable(path_json):
                    continue  # still being written -- picked up fresh on the next poll instead

                seen.add(path_json)
                try:
                    run_pipeline(path_json)
                except subprocess.CalledProcessError as error:
                    print(f"Pipeline failed for {path_json}: {error}")

    except KeyboardInterrupt:
        print("\nStopped watching.")


if __name__ == "__main__":
    main()